# Copy this file to .env. The app works in preview mode without credentials.
PORT=3000
CURRENCY=USD

# OpenAI API (enables live AI extraction; otherwise the app uses a labeled preview parser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# PayPal REST app credentials from the PayPal Developer Dashboard (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_INVOICER_GIVEN_NAME=Maya
PAYPAL_INVOICER_SURNAME=Chen
