# Copy this file to .env. The app works in preview mode without credentials.
PORT=3000
HOST=127.0.0.1
CURRENCY=USD

# Google AI Studio Gemini API (free-tier model for the hackathon demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal REST app credentials from the PayPal Developer Dashboard (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_INVOICER_GIVEN_NAME=Maya
PAYPAL_INVOICER_SURNAME=Chen
